# Foreman — environment variables (testnet only)
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# NEVER put a mainnet key here. Testnet keys only.

# Deployed Foreman contract account (filled in by scripts/deploy.sh)
CONTRACT_ID=foreman-ct-261110a.testnet

# Network: testnet (do not change to mainnet for this project)
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org

# Foreman (poster) testnet account — funds jobs from this account.
FOREMAN_ACCOUNT_ID=
FOREMAN_PRIVATE_KEY=ed25519:...
# ...or point at a near-cli style key file instead of the raw key:
# FOREMAN_KEY_FILE=~/.near-credentials/testnet/foreman.testnet.json

# Demo worker testnet account — quotes, accepts counters, submits work.
WORKER_ACCOUNT_ID=
WORKER_PRIVATE_KEY=ed25519:...
# WORKER_KEY_FILE=~/.near-credentials/testnet/worker.testnet.json

# Optional: OpenAI-compatible LLM for richer worker output.
# When unset, the worker uses the built-in rule-based generator.
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
